# Browser and data service
NEXT_PUBLIC_SPATIALITE_WASM_URL=/wasm/mod_spatialite.wasm

# AI provider: openai or azure
AI_PROVIDER=openai
AI_TEXT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Next.js data routes and VPS storage
# Optional absolute path; defaults to the repository's data/ directory locally.
# CHARTIZE_DATA_ROOT=/absolute/path/to/chartize/data
MAX_IMPORT_BYTES=524288000
ADMIN_TOKEN=replace-with-a-long-random-secret

# Chat-only ATProto login. Local default: http://localhost:3000.
# Set the public HTTPS origin on the VPS (also when testing a production build locally).
# CHARTIZE_PUBLIC_URL=https://chartize.dileepreddy.com
# CHARTIZE_AUTH_DIR=/absolute/path/to/private/auth
CHARTIZE_AI_USER_DAILY_TURNS=50
CHARTIZE_AI_DAILY_TURNS=300

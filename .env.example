# Browser and server routing
ENGINE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SPATIALITE_WASM_URL=/wasm/mod_spatialite.wasm

# AI provider: openai or azure
AI_PROVIDER=openai
AI_TEXT_MODEL=gpt-5.6-terra
OPENAI_API_KEY=

# Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Engine and VPS
WAREHOUSE_ROOT=./data
ENGINE_BIND=127.0.0.1:8787
MAX_IMPORT_BYTES=524288000
ADMIN_TOKEN=replace-with-a-long-random-secret

# Browser and data service
NEXT_PUBLIC_SPATIALITE_WASM_URL=/wasm/mod_spatialite.wasm

# AI provider: openai or azure
AI_PROVIDER=openai
AI_TEXT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Next.js data routes and VPS storage
CHARTIZE_DATA_ROOT=./data
MAX_IMPORT_BYTES=524288000
ADMIN_TOKEN=replace-with-a-long-random-secret
